# Linera Arcade Executor Configuration
# Copy this to .env and modify as needed

# ============================================================================
# REQUIRED: Chain and Application IDs
# ============================================================================
HUB_CHAIN_ID=925415e59d6e1d8ebb3ab2f5791ac170a21e79653f1606332ac4a62429dfca44
APPLICATION_ID=6c827a8df45212cdc97eaca2d286f4608511e632396dd6fea7783ef83d573782

# ============================================================================
# REQUIRED: Backend URL (for fetching pending rounds and notifying resolution)
# ============================================================================
BACKEND_URL=https://linera-arcade-backend.onrender.com

# ============================================================================
# PRODUCTION ONLY: Wallet Credentials (Render Environment Variables)
# ============================================================================
# For production deployment, set these as environment variables in Render.
# DO NOT commit actual wallet contents to this file!
#
# To get the values for your local wallet:
#   cat ~/.config/linera/wallet.json | base64 -w0
#   cat ~/.config/linera/keystore.json | base64 -w0
#
# Then set in Render dashboard:
#   LINERA_WALLET_JSON=<paste wallet.json contents>
#   LINERA_KEYSTORE_JSON=<paste keystore.json contents>
#
# NOTE: Use RAW JSON, not base64 (the executor expects JSON directly)

# LINERA_WALLET_JSON={"chains":...}  # Set in Render, NOT here
# LINERA_KEYSTORE_JSON={"keys":...}  # Set in Render, NOT here

# ============================================================================
# Linera Network Configuration
# ============================================================================
LINERA_FAUCET_URL=https://faucet.testnet-conway.linera.net

# ============================================================================
# Resolution Loop Configuration
# ============================================================================
# How often to check for expired rounds (in seconds)
RESOLUTION_INTERVAL_SECS=30

# ============================================================================
# Logging Configuration
# ============================================================================
RUST_LOG=arcade_executor=info,linera_core=warn

# ============================================================================
# LOCAL DEVELOPMENT ONLY: Custom wallet paths (optional)
# ============================================================================
# If not set, uses ~/.config/linera/wallet.json and keystore.json
# LINERA_WALLET_PATH=/path/to/wallet.json

