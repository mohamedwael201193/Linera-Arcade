# Linera Arcade Executor Configuration
# Copy this to .env and modify as needed

# Required: Chain and Application IDs
HUB_CHAIN_ID=925415e59d6e1d8ebb3ab2f5791ac170a21e79653f1606332ac4a62429dfca44
APPLICATION_ID=6c827a8df45212cdc97eaca2d286f4608511e632396dd6fea7783ef83d573782

# Linera Network Configuration
LINERA_FAUCET_URL=https://faucet.testnet-conway.linera.net

# Backend URL for fetching pending rounds and notifying resolution
# Required for backend-driven mode (new architecture)
BACKEND_URL=https://linera-arcade-backend.onrender.com

# Resolution Loop Configuration
# How often to check for expired rounds (in seconds)
RESOLUTION_INTERVAL_SECS=30

# Logging Configuration
RUST_LOG=arcade_executor=info,linera_core=warn

# Optional: Custom wallet/keystore paths
# LINERA_KEYSTORE=/path/to/keystore.json
# LINERA_WALLET_PATH=/path/to/wallet.json
